{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShuJinHao/PlcMcpPlatform/contracts/worker-v1.schema.json",
  "title": "PLC MCP internal worker protocol v1",
  "description": "Internal JSON envelope v1, additive managed-editing operations. Raw IDE requests use candidate=true and a file hash; durable managed jobs use manifest revisions. Runtime validation also checks cross-message IDs, operation-specific results, limits and ownership. Schema validity alone is not execution evidence.",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "projectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "objectId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxObjects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "edit": {
          "anyOf": [
            {
              "$ref": "#/$defs/editInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate": {
          "type": "boolean",
          "default": false
        },
        "ideProfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements": {
          "anyOf": [
            {
              "$ref": "#/$defs/template"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "projectPath",
        "objectId",
        "applicationId",
        "maxObjects"
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "jobId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "operation": {
          "enum": [
            "project.open",
            "project.tree.read",
            "pou.read",
            "project.compile",
            "gvl.read",
            "dut.read",
            "project.create",
            "project.save",
            "project.verify",
            "pou.create",
            "pou.update",
            "gvl.create",
            "gvl.update",
            "dut.create",
            "dut.update"
          ]
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64}|t2:[a-f0-9]{64}|m2:[a-f0-9]{32}:[a-f0-9]{64})$"
        },
        "deadlineUtc": {
          "type": "string",
          "format": "date-time"
        },
        "executionMode": {
          "enum": [
            "real",
            "fixture"
          ]
        },
        "payload": {
          "$ref": "#/$defs/input"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "jobId",
        "workspaceId",
        "operation",
        "expectedRevision",
        "deadlineUtc",
        "executionMode",
        "payload"
      ]
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "information"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "objectId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ]
    },
    "projectObject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "parentId",
        "name",
        "kind"
      ]
    },
    "openResult": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "opened": {
          "const": true
        },
        "sessionClosedAfterOperation": {
          "const": true
        }
      },
      "required": [
        "revision",
        "opened",
        "sessionClosedAfterOperation"
      ]
    },
    "structureResult": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objects": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/projectObject"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "objects",
        "truncated"
      ]
    },
    "sourceResult": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objectId": {
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "declaration": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        }
      },
      "required": [
        "revision",
        "objectId",
        "language",
        "declaration",
        "implementation"
      ]
    },
    "compileResult": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "applicationId": {
          "type": "string"
        },
        "succeeded": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "revision",
        "applicationId",
        "succeeded",
        "diagnostics"
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "jobId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionMode": {
          "enum": [
            "real",
            "fixture"
          ]
        },
        "payload": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "jobId",
        "outcome",
        "errorCode",
        "executionMode",
        "payload"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "errorCode": {
                "type": "null"
              },
              "payload": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/openResult"
                  },
                  {
                    "$ref": "#/$defs/structureResult"
                  },
                  {
                    "$ref": "#/$defs/sourceResult"
                  },
                  {
                    "$ref": "#/$defs/compileResult"
                  },
                  {
                    "$ref": "#/$defs/editWorkerResult"
                  },
                  {
                    "$ref": "#/$defs/managedEditResult"
                  },
                  {
                    "$ref": "#/$defs/declarationResult"
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "errorCode": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "editInput": {
      "type": "object",
      "properties": {
        "workspaceName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "templateId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "objectId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "declaration": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "pouType": {
          "anyOf": [
            {
              "enum": [
                "Program",
                "FunctionBlock",
                "Function"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "enum": [
                "ST",
                "IL",
                "LD",
                "FBD",
                "SFC",
                "CFC"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "dutType": {
          "anyOf": [
            {
              "enum": [
                "Structure",
                "Enumeration",
                "Alias",
                "Union"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "baseType": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workspaceName"
      ]
    },
    "deviceRequirement": {
      "type": "object",
      "properties": {
        "type": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ]
    },
    "template": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "projectFile": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "ideProfile": {
          "type": "string"
        },
        "targetController": {
          "type": "string"
        },
        "requiredLibraries": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string"
          }
        },
        "executionMode": {
          "enum": [
            "real",
            "fixture"
          ]
        },
        "controller": {
          "anyOf": [
            {
              "$ref": "#/$defs/deviceRequirement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "projectFile",
        "files",
        "ideProfile",
        "targetController",
        "requiredLibraries",
        "executionMode"
      ]
    },
    "dependencyResult": {
      "type": "object",
      "properties": {
        "controllerMatched": {
          "const": true
        },
        "libraryReferencesMatched": {
          "const": true
        },
        "installedDependenciesVerified": {
          "const": false
        }
      },
      "required": [
        "controllerMatched",
        "libraryReferencesMatched",
        "installedDependenciesVerified"
      ]
    },
    "editWorkerResult": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "saved": {
          "const": true
        },
        "reopened": {
          "const": true
        },
        "readBackVerified": {
          "const": true
        },
        "sessionClosedAfterOperation": {
          "const": true
        },
        "objectId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "declaration": {
          "type": "string"
        },
        "implementation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "$ref": "#/$defs/dependencyResult"
        }
      },
      "required": [
        "revision",
        "baseRevision",
        "saved",
        "reopened",
        "readBackVerified",
        "sessionClosedAfterOperation",
        "dependencies"
      ]
    },
    "managedEditResult": {
      "type": "object",
      "properties": {
        "workspaceName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^m2:[a-f0-9]{32}:[a-f0-9]{64}$"
        },
        "baseRevision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64}|t2:[a-f0-9]{64}|m2:[a-f0-9]{32}:[a-f0-9]{64})$"
        },
        "revisionScope": {
          "const": "managed_project_manifest_v2"
        },
        "projectPath": {
          "type": "string"
        },
        "backupPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidatePath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "published": {
          "const": true
        },
        "isDelivery": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engineeringResult": {
          "$ref": "#/$defs/editWorkerResult"
        },
        "dependencyValidation": {
          "const": "project_references_checked_installation_unverified"
        },
        "simulated": {
          "type": "boolean"
        }
      },
      "required": [
        "workspaceName",
        "revision",
        "baseRevision",
        "revisionScope",
        "projectPath",
        "backupPath",
        "candidatePath",
        "published",
        "isDelivery",
        "steps",
        "engineeringResult",
        "dependencyValidation",
        "simulated"
      ]
    },
    "declarationResult": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objectId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "gvl",
            "dut"
          ]
        },
        "declaration": {
          "type": "string"
        }
      },
      "required": [
        "revision",
        "objectId",
        "kind",
        "declaration"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
