{
  "schemaVersion": 1,
  "description": "Original motor engineering scenario: member/accessor source, exact patches, folder/task/library/device batch, revision-bound pages and delivery. Uses a clean template without pre-existing task configuration. Synthetic tests do not establish IDE compatibility.",
  "cases": [
    {
      "id": "create",
      "tool": "plc_project_create",
      "arguments": {
        "workspaceName": "p7-${runId}",
        "templateId": "${templateId}"
      },
      "bind": {
        "baseRevision": "/result/revision"
      }
    },
    {
      "id": "preview",
      "tool": "plc_project_batch_preview",
      "arguments": {
        "workspaceName": "p7-${runId}",
        "expectedRevision": "${baseRevision}",
        "plan": {
          "applicationId": "${applicationId}",
          "steps": [
            {
              "id": "group",
              "operation": "folder.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "Motors",
                "configuration": {
                  "object": {}
                }
              }
            },
            {
              "id": "target",
              "operation": "folder.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "Equipment",
                "configuration": {
                  "object": {}
                }
              }
            },
            {
              "id": "motor",
              "operation": "pou.create",
              "change": {
                "parentId": "@group",
                "name": "FB_Motor",
                "pouType": "FunctionBlock",
                "language": "ST",
                "declaration": "FUNCTION_BLOCK FB_Motor\nVAR\n runningState : BOOL;\n alarmState : BOOL;\nEND_VAR",
                "implementation": "// Motor instance"
              }
            },
            {
              "id": "start",
              "operation": "member.create",
              "change": {
                "parentId": "@motor",
                "name": "Start",
                "implementation": "runningState := TRUE;",
                "configuration": {
                  "member": {
                    "kind": "Method"
                  }
                }
              }
            },
            {
              "id": "stop",
              "operation": "member.create",
              "change": {
                "parentId": "@motor",
                "name": "Stop",
                "implementation": "runningState := FALSE;",
                "configuration": {
                  "member": {
                    "kind": "Method"
                  }
                }
              }
            },
            {
              "id": "reset",
              "operation": "member.create",
              "change": {
                "parentId": "@motor",
                "name": "Reset",
                "implementation": "alarmState := FALSE;",
                "configuration": {
                  "member": {
                    "kind": "Method"
                  }
                }
              }
            },
            {
              "id": "running",
              "operation": "member.create",
              "change": {
                "parentId": "@motor",
                "name": "Running",
                "configuration": {
                  "member": {
                    "kind": "Property",
                    "returnType": "BOOL",
                    "getter": {
                      "implementation": "Running := runningState;"
                    },
                    "setter": {
                      "implementation": "runningState := Running;"
                    }
                  }
                }
              }
            },
            {
              "id": "alarm",
              "operation": "member.create",
              "change": {
                "parentId": "@motor",
                "name": "Alarm",
                "configuration": {
                  "member": {
                    "kind": "Property",
                    "returnType": "BOOL",
                    "getter": {
                      "implementation": "Alarm := alarmState;"
                    },
                    "setter": {
                      "implementation": "alarmState := Alarm;"
                    }
                  }
                }
              }
            },
            {
              "id": "action",
              "operation": "member.create",
              "change": {
                "parentId": "@motor",
                "name": "Clear",
                "implementation": "alarmState := FALSE;",
                "configuration": {
                  "member": {
                    "kind": "Action"
                  }
                }
              }
            },
            {
              "id": "state",
              "operation": "dut.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "MotorState",
                "dutType": "Enumeration",
                "declaration": "TYPE MotorState : (Idle, Running); END_TYPE"
              }
            },
            {
              "id": "globals",
              "operation": "gvl.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "GVL_Motor",
                "declaration": "VAR_GLOBAL\n Enable : BOOL;\nEND_VAR"
              }
            },
            {
              "id": "main",
              "operation": "pou.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "MAIN",
                "pouType": "Program",
                "language": "ST",
                "declaration": "PROGRAM MAIN\nVAR\n motor : FB_Motor;\nEND_VAR",
                "implementation": "motor();"
              }
            },
            {
              "id": "configuration",
              "operation": "task.configuration.create",
              "change": {
                "parentId": "${applicationId}"
              }
            },
            {
              "id": "task",
              "operation": "task.create",
              "change": {
                "parentId": "@configuration",
                "name": "Cycle",
                "configuration": {
                  "task": {
                    "kind": "Cyclic",
                    "priority": "1",
                    "interval": "20",
                    "intervalUnit": "ms"
                  }
                }
              }
            },
            {
              "id": "calls",
              "operation": "task.calls.set",
              "change": {
                "objectId": "@task",
                "configuration": {
                  "calls": [
                    {
                      "pouId": "@main",
                      "pouName": "MAIN"
                    }
                  ]
                }
              }
            },
            {
              "id": "library",
              "operation": "library.add",
              "change": {
                "objectId": "${libraryManagerId}",
                "configuration": {
                  "library": {
                    "name": "${libraryName}"
                  }
                }
              }
            },
            {
              "id": "placeholder",
              "operation": "library.placeholder.set",
              "change": {
                "objectId": "${libraryManagerId}",
                "configuration": {
                  "library": {
                    "name": "MotorLibrary",
                    "defaultResolution": "${libraryName}"
                  }
                }
              }
            },
            {
              "id": "rename",
              "operation": "object.rename",
              "change": {
                "objectId": "@group",
                "name": "Retired",
                "configuration": {
                  "object": {
                    "expectedName": "Motors"
                  }
                }
              }
            },
            {
              "id": "move",
              "operation": "object.move",
              "change": {
                "objectId": "@motor",
                "parentId": "@target",
                "configuration": {
                  "object": {
                    "expectedName": "FB_Motor"
                  }
                }
              }
            },
            {
              "id": "remove_group",
              "operation": "object.delete",
              "change": {
                "objectId": "@group",
                "configuration": {
                  "object": {
                    "expectedName": "Retired"
                  }
                }
              }
            },
            {
              "id": "temporary_task",
              "operation": "task.create",
              "change": {
                "parentId": "@configuration",
                "name": "Unused",
                "configuration": {
                  "task": {
                    "kind": "Cyclic",
                    "priority": "2",
                    "interval": "50",
                    "intervalUnit": "ms"
                  }
                }
              }
            },
            {
              "id": "remove_task",
              "operation": "task.delete",
              "change": {
                "objectId": "@temporary_task",
                "configuration": {
                  "object": {
                    "expectedName": "Unused"
                  }
                }
              }
            },
            {
              "id": "io",
              "operation": "device.add",
              "change": {
                "parentId": "${controllerId}",
                "name": "MotorIO",
                "configuration": {
                  "device": "${deviceSettings}"
                }
              }
            },
            {
              "id": "parameter",
              "operation": "device.parameter.write",
              "change": {
                "objectId": "@io",
                "configuration": {
                  "parameter": {
                    "address": "${parameterAddress}",
                    "value": "${parameterValue}"
                  }
                }
              }
            },
            {
              "id": "mapping",
              "operation": "device.io.map",
              "change": {
                "objectId": "@io",
                "configuration": {
                  "mapping": {
                    "address": "${mappingAddress}",
                    "variable": "GVL_Motor.Enable"
                  }
                }
              }
            },
            {
              "id": "temporary_device",
              "operation": "device.add",
              "change": {
                "parentId": "${controllerId}",
                "name": "UnusedIO",
                "configuration": {
                  "device": "${deviceSettings}"
                }
              }
            },
            {
              "id": "remove_device",
              "operation": "device.remove",
              "change": {
                "objectId": "@temporary_device",
                "configuration": {
                  "object": {
                    "expectedName": "UnusedIO",
                    "recursive": true
                  }
                }
              }
            },
            {
              "id": "remove_library",
              "operation": "library.remove",
              "change": {
                "objectId": "${libraryManagerId}",
                "configuration": {
                  "library": {
                    "name": "${libraryName}"
                  }
                }
              }
            }
          ],
          "deviceScopeIds": [
            "${controllerId}"
          ],
          "libraryManagerIds": [
            "${libraryManagerId}"
          ]
        }
      },
      "bind": {
        "planHash": "/value/planSha256"
      }
    },
