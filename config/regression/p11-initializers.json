{
  "schemaVersion": 1,
  "description": "Bounded TC6 aggregate initializers in LD/FBD/SFC; original DUTs, batch compilation, guarded update, initializer diff and exact delivery. Fixture compilation is simulated. Real template requires an empty Task Configuration location; graphical child protection stays enabled.",
  "cases": [
    {
      "id": "create",
      "tool": "plc_project_create",
      "arguments": {
        "workspaceName": "p11-${runId}",
        "templateId": "${templateId}"
      },
      "bind": {
        "baseRevision": "/result/revision"
      }
    },
    {
      "id": "ld-generate",
      "tool": "plc_graph_generate",
      "arguments": {
        "program": {
          "name": "InitLD",
          "pouType": "program",
          "language": "LD",
          "profile": "graph-v2",
          "variables": [
            {
              "name": "Flags",
              "type": "BOOL",
              "dimensions": [
                {
                  "lower": 0,
                  "upper": 3
                }
              ],
              "initializer": {
                "kind": "array",
                "items": [
                  {
                    "value": {
                      "kind": "simple",
                      "value": "TRUE"
                    },
                    "repeat": 1
                  },
                  {
                    "value": {
                      "kind": "simple",
                      "value": "FALSE"
                    },
                    "repeat": 3
                  }
                ]
              }
            },
            {
              "name": "Running",
              "type": "BOOL",
              "initialValue": "FALSE"
            }
          ],
          "nodes": [
            {
              "id": 1,
              "kind": "leftPowerRail",
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 2,
              "kind": "contact",
              "expression": "Flags[0]",
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 1
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 3,
              "kind": "coil",
              "expression": "Running",
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 2
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ],
              "executionOrder": 1
            },
            {
              "id": 4,
              "kind": "rightPowerRail",
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 3
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "bind": {
        "ldArtifact": "/value/artifact/artifactId",
        "ldHash": "/value/graph/semanticSha256"
      }
    },
    {
      "id": "ld-decode",
      "tool": "plc_graph_decode",
      "arguments": {
        "artifactId": "${ldArtifact}"
      },
      "expect": [
        {
          "path": "/value/semanticSha256",
          "equals": "${ldHash}"
        },
        {
          "path": "/value/profile",
          "equals": "graph-v2"
        }
      ]
    },
    {
      "id": "fbd-generate",
      "tool": "plc_graph_generate",
      "arguments": {
        "program": {
          "name": "InitFBD",
          "pouType": "program",
          "language": "FBD",
          "profile": "graph-v2",
          "variables": [
            {
              "name": "Result",
              "type": "INT"
            },
            {
              "name": "Thresholds",
              "type": "INT",
              "dimensions": [
                {
                  "lower": -1,
                  "upper": 1
                },
                {
                  "lower": 2,
                  "upper": 3
                }
              ],
              "initializer": {
                "kind": "array",
                "items": [
                  {
                    "value": {
                      "kind": "simple",
                      "value": "10"
                    },
                    "repeat": 2
                  },
                  {
                    "value": {
                      "kind": "simple",
                      "value": "20"
                    },
                    "repeat": 3
                  }
                ]
              }
            },
            {
              "name": "Settings",
              "type": "MachineSettings",
              "initializer": {
                "kind": "struct",
                "members": [
                  {
                    "name": "Label",
                    "value": {
                      "kind": "simple",
                      "value": "'Line A'"
                    }
                  },
                  {
                    "name": "Limits",
                    "value": {
                      "kind": "array",
                      "items": [
                        {
                          "value": {
                            "kind": "simple",
                            "value": "25"
                          },
                          "repeat": 3
                        }
                      ]
                    }
                  },
                  {
                    "name": "Drive",
                    "value": {
                      "kind": "struct",
                      "members": [
                        {
                          "name": "Enabled",
                          "value": {
                            "kind": "simple",
                            "value": "TRUE"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "name": "Drives",
              "type": "DriveSettings",
              "dimensions": [
                {
                  "lower": 0,
                  "upper": 1
                }
              ],
              "initializer": {
                "kind": "array",
                "items": [
                  {
                    "value": {
                      "kind": "struct",
                      "members": [
                        {
                          "name": "Enabled",
                          "value": {
                            "kind": "simple",
                            "value": "TRUE"
                          }
                        },
                        {
                          "name": "Speed",
                          "value": {
                            "kind": "simple",
                            "value": "100"
                          }
                        }
                      ]
                    },
                    "repeat": 2
                  }
                ]
              }
            }
          ],
          "nodes": [
            {
              "id": 1,
              "kind": "inVariable",
              "expression": "Thresholds[-1,2]",
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 2,
              "kind": "outVariable",
              "expression": "Result",
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 1
                    }
                  ]
                }
              ],
              "executionOrder": 1
            }
          ]
        }
      },
      "bind": {
        "fbdArtifact": "/value/artifact/artifactId",
        "fbdHash": "/value/graph/semanticSha256"
      }
    },
    {
      "id": "fbd-decode",
      "tool": "plc_graph_decode",
      "arguments": {
        "artifactId": "${fbdArtifact}"
      },
      "expect": [
        {
          "path": "/value/semanticSha256",
          "equals": "${fbdHash}"
        },
        {
          "path": "/value/profile",
          "equals": "graph-v2"
        }
      ]
    },
    {
      "id": "sfc-generate",
      "tool": "plc_graph_generate",
      "arguments": {
        "program": {
          "name": "InitSequence",
          "pouType": "program",
          "language": "SFC",
          "variables": [
            {
              "name": "Start",
              "type": "BOOL"
            },
            {
              "name": "Stop",
              "type": "BOOL"
            },
            {
              "name": "Running",
              "type": "BOOL"
            },
            {
              "name": "Delays",
              "type": "TIME",
              "dimensions": [
                {
                  "lower": 0,
                  "upper": 1
                }
              ],
              "initializer": {
                "kind": "array",
                "items": [
                  {
                    "value": {
                      "kind": "simple",
                      "value": "T#100ms"
                    },
                    "repeat": 2
                  }
                ]
              }
            }
          ],
          "actions": [
            {
              "name": "ResetOutput",
              "implementation": "Running := FALSE;"
            },
            {
              "name": "DriveOutput",
              "implementation": "Running := TRUE;"
            }
          ],
          "nodes": [
            {
              "id": 1,
              "kind": "step",
              "name": "Idle",
              "initial": true,
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 2,
              "kind": "transition",
              "expression": "Start",
              "y": 50,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 1
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 3,
              "kind": "step",
              "name": "Run",
              "y": 100,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 2
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 4,
              "kind": "actionBlock",
              "action": "DriveOutput",
              "x": 100,
              "y": 100,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 3
                    }
                  ]
                }
              ]
            },
            {
              "id": 5,
              "kind": "transition",
              "expression": "Stop",
              "y": 150,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 3
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 6,
              "kind": "jumpStep",
              "name": "Idle",
              "y": 200,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 5
                    }
                  ]
                }
              ]
            },
            {
              "id": 7,
              "kind": "actionBlock",
              "action": "ResetOutput",
              "x": 100,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 1
                    }
                  ]
                }
              ]
            }
          ],
          "profile": "graph-v2"
        }
      },
      "bind": {
        "sfcArtifact": "/value/artifact/artifactId",
        "sfcHash": "/value/graph/semanticSha256"
      }
    },
    {
      "id": "sfc-decode",
      "tool": "plc_graph_decode",
      "arguments": {
        "artifactId": "${sfcArtifact}"
      },
      "expect": [
        {
          "path": "/value/semanticSha256",
          "equals": "${sfcHash}"
        },
        {
          "path": "/value/profile",
          "equals": "graph-v2"
        }
      ]
    },
    {
      "id": "preview",
      "tool": "plc_project_batch_preview",
      "arguments": {
        "workspaceName": "p11-${runId}",
        "expectedRevision": "${baseRevision}",
        "plan": {
          "applicationId": "${applicationId}",
          "steps": [
            {
              "id": "drive",
              "operation": "dut.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "DriveSettings",
                "dutType": "Structure",
                "declaration": "TYPE DriveSettings :\nSTRUCT\n Enabled : BOOL;\n Speed : INT;\nEND_STRUCT\nEND_TYPE"
              }
            },
            {
              "id": "settings",
              "operation": "dut.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "MachineSettings",
                "dutType": "Structure",
                "declaration": "TYPE MachineSettings :\nSTRUCT\n Label : STRING(80);\n Limits : ARRAY[0..2] OF INT;\n Drive : DriveSettings;\nEND_STRUCT\nEND_TYPE"
              }
            },
            {
              "id": "ld",
              "operation": "pou.graph.write",
              "change": {
                "parentId": "${applicationId}",
                "name": "InitLD",
                "artifactId": "${ldArtifact}"
              }
            },
            {
              "id": "fbd",
              "operation": "pou.graph.write",
              "change": {
                "parentId": "${applicationId}",
                "name": "InitFBD",
                "artifactId": "${fbdArtifact}"
              }
            },
            {
              "id": "sfc",
              "operation": "pou.graph.write",
              "change": {
                "parentId": "${applicationId}",
                "name": "InitSequence",
                "artifactId": "${sfcArtifact}"
              }
            },
            {
              "id": "main",
              "operation": "pou.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "MAIN_Initializers",
                "pouType": "Program",
                "language": "ST",
                "declaration": "PROGRAM MAIN_Initializers",
                "implementation": "InitLD();\nInitFBD();\nInitSequence();"
              }
            },
            {
              "id": "configuration",
              "operation": "task.configuration.create",
              "change": {
                "parentId": "${applicationId}"
              }
            },
            {
              "id": "task",
              "operation": "task.create",
              "change": {
                "parentId": "@configuration",
                "name": "Cycle",
                "configuration": {
                  "task": {
                    "kind": "Cyclic",
                    "priority": "1",
                    "interval": "20",
                    "intervalUnit": "ms"
                  }
                }
              }
            },
            {
              "id": "calls",
              "operation": "task.calls.set",
              "change": {
                "objectId": "@task",
                "configuration": {
                  "calls": [
                    {
                      "pouId": "@main",
                      "pouName": "MAIN_Initializers"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "bind": {
        "planHash": "/value/planSha256"
      }
    },
    {
      "id": "apply",
      "tool": "plc_project_batch_apply",
      "arguments": {
        "workspaceName": "p11-${runId}",
        "expectedRevision": "${baseRevision}",
        "plan": {
          "applicationId": "${applicationId}",
          "steps": [
            {
              "id": "drive",
              "operation": "dut.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "DriveSettings",
                "dutType": "Structure",
                "declaration": "TYPE DriveSettings :\nSTRUCT\n Enabled : BOOL;\n Speed : INT;\nEND_STRUCT\nEND_TYPE"
              }
            },
            {
              "id": "settings",
              "operation": "dut.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "MachineSettings",
