          "pouType": "program",
          "language": "FBD",
          "profile": "graph-v2",
          "variables": [
            {
              "name": "Result",
              "type": "INT"
            },
            {
              "name": "Thresholds",
              "type": "INT",
              "dimensions": [
                {
                  "lower": -1,
                  "upper": 1
                },
                {
                  "lower": 2,
                  "upper": 3
                }
              ],
              "initializer": {
                "kind": "array",
                "items": [
                  {
                    "value": {
                      "kind": "simple",
                      "value": "11"
                    },
                    "repeat": 2
                  },
                  {
                    "value": {
                      "kind": "simple",
                      "value": "20"
                    },
                    "repeat": 3
                  }
                ]
              }
            },
            {
              "name": "Settings",
