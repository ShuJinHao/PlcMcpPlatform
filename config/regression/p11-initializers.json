    {
      "id": "patch-preview",
      "tool": "plc_project_batch_preview",
      "arguments": {
        "workspaceName": "p11-${runId}",
        "expectedRevision": "${revision}",
        "plan": {
          "applicationId": "${applicationId}",
          "steps": [
            {
              "id": "fbd",
              "operation": "pou.graph.write",
              "change": {
                "parentId": "${applicationId}",
                "name": "InitFBD",
                "objectId": "${fbdId}",
                "artifactId": "${newArtifact}",
                "expectedGraphSha256": "${fbdHash}"
              }
            }
          ]
        }
      },
      "bind": {
