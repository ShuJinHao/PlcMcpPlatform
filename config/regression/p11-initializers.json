            },
            {
              "id": "fbd",
              "operation": "pou.graph.write",
              "change": {
                "parentId": "${applicationId}",
                "name": "InitFBD",
                "artifactId": "${fbdArtifact}"
              }
            },
            {
              "id": "sfc",
              "operation": "pou.graph.write",
              "change": {
                "parentId": "${applicationId}",
                "name": "InitSequence",
                "artifactId": "${sfcArtifact}"
              }
            },
            {
              "id": "main",
              "operation": "pou.create",
              "change": {
                "parentId": "${applicationId}",
                "name": "MAIN_Initializers",
                "pouType": "Program",
                "language": "ST",
                "declaration": "PROGRAM MAIN_Initializers",
                "implementation": "InitLD();\nInitFBD();\nInitSequence();"
              }
            },
            {
              "id": "configuration",
              "operation": "task.configuration.create",
              "change": {
                "parentId": "${applicationId}"
              }
            },
            {
              "id": "task",
              "operation": "task.create",
              "change": {
                "parentId": "@configuration",
                "name": "Cycle",
                "configuration": {
                  "task": {
                    "kind": "Cyclic",
                    "priority": "1",
                    "interval": "20",
                    "intervalUnit": "ms"
                  }
                }
              }
            },
            {
              "id": "calls",
              "operation": "task.calls.set",
              "change": {
                "objectId": "@task",
                "configuration": {
                  "calls": [
                    {
                      "pouId": "@main",
                      "pouName": "MAIN_Initializers"
                    }
                  ]
                }
              }
            }
          ]
        },
        "expectedPlanSha256": "${planHash}"
      },
      "bind": {
        "revision": "/result/revision",
        "projectPath": "/result/projectPath",
        "ldId": "/result/engineeringResult/batch/aliases/ld",
        "fbdId": "/result/engineeringResult/batch/aliases/fbd",
        "sfcId": "/result/engineeringResult/batch/aliases/sfc"
      },
      "expect": [
        {
          "path": "/result/published",
          "equals": true
        }
      ]
    },
    {
      "id": "ld-read",
      "tool": "plc_pou_graph_read",
      "arguments": {
        "projectPath": "${projectPath}",
        "objectId": "${ldId}"
      },
      "expect": [
        {
          "path": "/result/exchange/graph/semanticSha256",
          "equals": "${ldHash}"
        }
      ]
    },
    {
      "id": "fbd-read",
      "tool": "plc_pou_graph_read",
      "arguments": {
        "projectPath": "${projectPath}",
        "objectId": "${fbdId}"
      },
      "expect": [
        {
          "path": "/result/exchange/graph/semanticSha256",
