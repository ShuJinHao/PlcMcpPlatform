    {
      "id": "initializer-diff",
      "tool": "plc_project_diff",
      "arguments": {
        "workspaceName": "p11-${runId}",
        "expectedHeadRevision": "${patchedRevision}",
        "fromRevision": "${revision}",
        "toRevision": "${patchedRevision}",
        "applicationId": "${applicationId}",
        "objectId": "${fbdId}",
        "toObjectId": "${fbdNewId}",
        "graph": true
      },
      "expect": [
        {
          "path": "/result/objectDifference/totalChanges",
          "equals": 1
        },
        {
          "path": "/result/objectDifference/changes/0/component",
          "equals": "variables"
        },
        {
          "path": "/result/objectDifference/changes/0/before/initializer/items/0/value/value",
          "equals": "10"
