{
  "schemaVersion": 1,
  "description": "Original LD/FBD/basic-SFC exchange and candidate regression. Requires a template Application without Task Configuration. Real results remain unverified until reviewed.",
  "cases": [
    {
      "id": "create",
      "tool": "plc_project_create",
      "arguments": {
        "workspaceName": "p4-${runId}",
        "templateId": "${templateId}"
      },
      "bind": {
        "revision": "/result/revision",
        "projectPath": "/result/projectPath"
      }
    },
    {
      "id": "ld-generate",
      "tool": "plc_graph_generate",
      "arguments": {
        "program": {
          "name": "StartStop",
          "pouType": "program",
          "language": "LD",
          "variables": [
            {
              "name": "Start",
              "type": "BOOL"
            },
            {
              "name": "Stop",
              "type": "BOOL"
            },
            {
              "name": "Running",
              "type": "BOOL"
            }
          ],
          "nodes": [
            {
              "id": 1,
              "kind": "leftPowerRail",
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 2,
              "kind": "contact",
              "expression": "Start",
              "x": 40,
              "y": 20,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 1
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 3,
              "kind": "contact",
              "expression": "Running",
              "x": 40,
              "y": 60,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 1
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 4,
              "kind": "contact",
              "expression": "Stop",
              "negated": true,
              "x": 120,
              "y": 20,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 2
                    },
                    {
                      "sourceId": 3
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ]
            },
            {
              "id": 5,
              "kind": "coil",
              "expression": "Running",
              "x": 200,
              "y": 20,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 4
                    }
                  ]
                }
              ],
              "outputs": [
                {
                  "name": ""
                }
              ],
              "executionOrder": 1
            },
            {
              "id": 6,
              "kind": "rightPowerRail",
              "x": 280,
              "y": 20,
              "inputs": [
                {
                  "name": "",
                  "connections": [
                    {
                      "sourceId": 5
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "bind": {
        "artifactId": "/value/artifact/artifactId",
        "expectedHash": "/value/graph/semanticSha256"
      }
    },
    {
      "id": "ld-inspect",
      "tool": "plc_exchange_validate",
      "arguments": {
        "artifactId": "${artifactId}"
      },
      "expect": [
        {
          "path": "/value/format",
          "equals": "plcopen"
        },
        {
          "path": "/value/languages",
          "equals": [
            "LD"
          ]
        }
      ]
    },
    {
      "id": "ld-decode",
      "tool": "plc_graph_decode",
      "arguments": {
        "artifactId": "${artifactId}"
      },
      "expect": [
        {
          "path": "/value/semanticSha256",
          "equals": "${expectedHash}"
        }
      ]
    },
    {
      "id": "ld-read-chunk",
      "tool": "plc_exchange_read",
      "arguments": {
        "artifactId": "${artifactId}",
        "maxChars": 128
      },
      "expect": [
        {
          "path": "/value/offset",
          "equals": 0
        },
        {
          "path": "/value/nextOffset",
          "equals": 128
        },
        {
          "path": "/value/complete",
          "equals": false
        }
      ]
    },
    {
      "id": "ld-write",
      "tool": "plc_pou_graph_write",
      "arguments": {
        "workspaceName": "p4-${runId}",
        "expectedRevision": "${revision}",
        "parentId": "${applicationId}",
        "artifactId": "${artifactId}"
      },
      "bind": {
        "revision": "/result/revision",
        "projectPath": "/result/projectPath",
        "objectId": "/result/engineeringResult/exchange/objectIds/0"
      },
      "expect": [
        {
          "path": "/result/engineeringResult/exchange/graph/semanticSha256",
          "equals": "${expectedHash}"
        },
        {
          "path": "/result/published",
          "equals": true
        }
      ]
    },
    {
      "id": "ld-read",
      "tool": "plc_pou_graph_read",
      "arguments": {
        "projectPath": "${projectPath}",
        "objectId": "${objectId}"
      },
      "bind": {
        "graphHash": "/result/exchange/graph/semanticSha256"
      },
      "expect": [
        {
          "path": "/result/exchange/graph/semanticSha256",
          "equals": "${expectedHash}"
        }
      ]
    },
    {
