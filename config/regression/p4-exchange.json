        {
          "path": "/errorCode",
          "equals": "graph_revision_conflict"
        }
      ]
    },
    {
      "id": "stale-kept-head",
      "tool": "plc_workspace_get",
      "arguments": {
        "workspaceName": "p4-${runId}"
      },
      "expect": [
        {
          "path": "/value/revision",
          "equals": "${revision}"
        }
      ]
