    {
      "id": "ld-update",
      "tool": "plc_pou_graph_write",
      "arguments": {
        "workspaceName": "p4-${runId}",
        "expectedRevision": "${revision}",
        "parentId": "${applicationId}",
        "artifactId": "${artifactId}",
        "objectId": "${objectId}",
        "expectedGraphSha256": "${graphHash}"
      },
      "bind": {
        "revision": "/result/revision",
        "projectPath": "/result/projectPath",
        "ldId": "/result/engineeringResult/exchange/objectIds/0"
      },
      "expect": [
        {
          "path": "/result/engineeringResult/exchange/graph/semanticSha256",
